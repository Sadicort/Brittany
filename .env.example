DISCRIMINE_BOT_TOKEN=REEMPLAZA_CON_UN_TOKEN_NUEVO
DISCRIMINE_CHANNEL_ID=1427773746474647663
DISCRIMINE_TARGET_USER_ID=
DISCRIMINE_AUTO_INTERVAL_HOURS=6
DISCRIMINE_FACTS_CHANNEL_ID=
DISCRIMINE_FACTS_HOUR=20

# IA local con Ollama (tambien puede configurarse en data/ollama.toml)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_SECONDS=120
AI_MEMORY_FILE=data/ai-memory.json
# 0 conserva todo el historial inmediato; MEMORY_UNLIMITED=true fuerza este comportamiento
AI_MAX_HISTORY_MESSAGES=0
# AI_SYSTEM_PROMPT=Eres DISCRIMINE, un bot amigable que responde en espanol.

# Memoria colectiva + perfil conversacional
MEMORY_ENABLED=true
MEMORY_DIRECTORY=data/memory
MEMORY_EVENT_GAP_MINUTES=20
MEMORY_EVENT_MIN_MESSAGES=12
MEMORY_EVENT_MIN_PARTICIPANTS=3
MEMORY_SEMANTIC_EXTRACTION=true
MEMORY_UNLIMITED=true
# guild registra los comandos inmediatamente en cada servidor; global puede tardar en propagarse
MEMORY_COMMAND_SCOPE=guild
# elimina las copias globales administradas por este modulo para que Discord no muestre duplicados
MEMORY_CLEAN_DUPLICATE_GLOBALS=true
